<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.GameRecordMapper">

    <resultMap id="playerMap" type="com.tencent.wxcloudrun.model.GamePlayer">
        <id property="id" column="id"/>
        <result property="gameId" column="game_id"/>
        <result property="userId" column="user_id"/>
        <result property="seat" column="seat"/>
        <result property="initialCards" column="initial_cards"/>
        <result property="pickedScore" column="picked_score"/>
        <result property="rankNo" column="rank_no"/>
        <result property="scoreChange" column="score_change"/>
        <result property="isWin" column="is_win"/>
    </resultMap>

    <resultMap id="playMap" type="com.tencent.wxcloudrun.model.GamePlay">
        <id property="id" column="id"/>
        <result property="gameId" column="game_id"/>
        <result property="trickNo" column="trick_id"/>
        <result property="seqNo" column="seq_no"/>
        <result property="userId" column="user_id"/>
        <result property="action" column="action"/>
        <result property="cardType" column="card_type"/>
        <result property="mainToken" column="main_rank"/>
        <result property="cards" column="cards"/>
        <result property="cardsCount" column="cards_count"/>
    </resultMap>

    <insert id="insertPlayer" parameterType="com.tencent.wxcloudrun.model.GamePlayer"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `game_player`(`game_id`, `user_id`, `seat`, `initial_cards`, `picked_score`,
                                  `rank_no`, `score_change`, `is_win`)
        VALUES(#{gameId}, #{userId}, #{seat}, #{initialCards}, #{pickedScore},
               #{rankNo}, #{scoreChange}, #{isWin})
    </insert>

    <select id="selectPlayers" resultMap="playerMap">
        SELECT `id`, `game_id`, `user_id`, `seat`, `initial_cards`, `picked_score`,
               `rank_no`, `score_change`, `is_win`
        FROM `game_player`
        WHERE `game_id` = #{gameId}
        ORDER BY `seat` ASC
    </select>

    <update id="updatePlayerResult" parameterType="com.tencent.wxcloudrun.model.GamePlayer">
        UPDATE `game_player`
        SET `picked_score` = #{pickedScore},
            `rank_no` = #{rankNo},
            `score_change` = #{scoreChange},
            `is_win` = #{isWin}
        WHERE `game_id` = #{gameId} AND `user_id` = #{userId}
    </update>

    <insert id="insertPlay" parameterType="com.tencent.wxcloudrun.model.GamePlay"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `game_play`(`game_id`, `trick_id`, `seq_no`, `user_id`, `action`,
                                `card_type`, `main_rank`, `cards`, `cards_count`)
        VALUES(#{gameId}, #{trickNo}, #{seqNo}, #{userId}, #{action},
               #{cardType}, #{mainToken}, #{cards}, #{cardsCount})
    </insert>

    <select id="selectPlays" resultMap="playMap">
        SELECT `id`, `game_id`, `trick_id`, `seq_no`, `user_id`, `action`,
               `card_type`, `main_rank`, `cards`, `cards_count`
        FROM `game_play`
        WHERE `game_id` = #{gameId}
        ORDER BY `id` ASC
    </select>

</mapper>
