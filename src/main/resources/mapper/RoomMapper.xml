<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.RoomMapper">

    <resultMap id="roomMap" type="com.tencent.wxcloudrun.model.Room">
        <id property="id" column="id"/>
        <result property="roomNo" column="room_no"/>
        <result property="ownerUserId" column="owner_user_id"/>
        <result property="source" column="source"/>
        <result property="status" column="status"/>
        <result property="maxPlayer" column="max_player"/>
        <result property="totalRound" column="total_round"/>
        <result property="currentRound" column="current_round"/>
        <result property="baseScore" column="base_score"/>
        <result property="options" column="options"/>
        <result property="revision" column="revision"/>
        <result property="expireAt" column="expire_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        `id`, `room_no`, `owner_user_id`, `source`, `status`, `max_player`, `total_round`,
        `current_round`, `base_score`, `options`, `revision`, `expire_at`, `created_at`, `updated_at`
    </sql>

    <select id="selectById" resultMap="roomMap">
        SELECT <include refid="columns"/> FROM `room` WHERE `id` = #{id} LIMIT 1
    </select>

    <select id="selectByRoomNo" resultMap="roomMap">
        SELECT <include refid="columns"/> FROM `room` WHERE `room_no` = #{roomNo} LIMIT 1
    </select>

    <select id="selectLobbyRooms" resultMap="roomMap">
        SELECT <include refid="columns"/> FROM `room`
        WHERE `status` = 0
        ORDER BY `id` DESC
        LIMIT #{limit}
    </select>

    <insert id="insert" parameterType="com.tencent.wxcloudrun.model.Room"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `room`(`room_no`, `owner_user_id`, `source`, `status`, `max_player`,
                           `total_round`, `current_round`, `base_score`, `options`, `expire_at`)
        VALUES(#{roomNo}, #{ownerUserId}, #{source}, #{status}, #{maxPlayer},
               #{totalRound}, #{currentRound}, #{baseScore}, #{options}, #{expireAt})
    </insert>

    <!-- 下面几个 UPDATE 都带 revision = revision + 1：
         单条 UPDATE 在 InnoDB 里是行级原子操作，多实例部署也不会各自加出重复版本号 -->

    <update id="updateStatus">
        UPDATE `room` SET `status` = #{status}, `revision` = `revision` + 1 WHERE `id` = #{id}
    </update>

    <update id="updateOwner">
        UPDATE `room` SET `owner_user_id` = #{ownerUserId}, `revision` = `revision` + 1 WHERE `id` = #{id}
    </update>

    <update id="updateConfig" parameterType="com.tencent.wxcloudrun.model.Room">
        UPDATE `room`
        SET `max_player` = #{maxPlayer},
            `options` = #{options},
            `revision` = `revision` + 1
        WHERE `id` = #{id}
    </update>

    <update id="touch">
        UPDATE `room` SET `updated_at` = NOW(3), `revision` = `revision` + 1 WHERE `id` = #{id}
    </update>

    <!-- 开局：配置和状态一起落库，revision 只 +1 -->
    <update id="updateConfigAndStatus" parameterType="com.tencent.wxcloudrun.model.Room">
        UPDATE `room`
        SET `max_player` = #{maxPlayer},
            `options` = #{options},
            `status` = #{status},
            `revision` = `revision` + 1
        WHERE `id` = #{id}
    </update>

</mapper>
