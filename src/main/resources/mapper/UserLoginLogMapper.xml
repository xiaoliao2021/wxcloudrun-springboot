<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.UserLoginLogMapper">

    <insert id="insert" parameterType="com.tencent.wxcloudrun.model.UserLoginLog">
        INSERT INTO `user_login_log`(`user_id`, `action`, `result`, `fail_code`, `ip`, `device`, `channel`, `scene`)
        VALUES(#{userId}, #{action}, #{result}, #{failCode}, #{ip}, #{device}, #{channel}, #{scene})
    </insert>

</mapper>
