<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.GameMapper">

    <resultMap id="gameMap" type="com.tencent.wxcloudrun.model.Game">
        <id property="id" column="id"/>
        <result property="roomId" column="room_id"/>
        <result property="roundNo" column="round_no"/>
        <result property="status" column="status"/>
        <result property="ruleType" column="rule_type"/>
        <result property="dealerUserId" column="dealer_user_id"/>
        <result property="winnerUserId" column="winner_user_id"/>
        <result property="deckSeed" column="deck_seed"/>
        <result property="deckRemain" column="deck_remain"/>
        <result property="startedAt" column="started_at"/>
        <result property="endedAt" column="ended_at"/>
    </resultMap>

    <sql id="columns">
        `id`, `room_id`, `round_no`, `status`, `rule_type`, `dealer_user_id`, `winner_user_id`,
        `deck_seed`, `deck_remain`, `started_at`, `ended_at`
    </sql>

    <insert id="insert" parameterType="com.tencent.wxcloudrun.model.Game"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `game`(`room_id`, `round_no`, `status`, `rule_type`, `dealer_user_id`,
                           `deck_seed`, `deck_remain`, `started_at`)
        VALUES(#{roomId}, #{roundNo}, #{status}, #{ruleType}, #{dealerUserId},
               #{deckSeed}, #{deckRemain}, NOW())
    </insert>

    <select id="selectById" resultMap="gameMap">
        SELECT <include refid="columns"/> FROM `game` WHERE `id` = #{id} LIMIT 1
    </select>

    <select id="selectPlayingByRoom" resultMap="gameMap">
        SELECT <include refid="columns"/> FROM `game`
        WHERE `room_id` = #{roomId} AND `status` IN (0, 1)
        ORDER BY `id` DESC
        LIMIT 1
    </select>

    <update id="updateDeckRemain">
        UPDATE `game` SET `deck_remain` = #{deckRemain} WHERE `id` = #{id}
    </update>

    <update id="updateStatus">
        UPDATE `game` SET `status` = #{status} WHERE `id` = #{id}
    </update>

    <update id="settle" parameterType="com.tencent.wxcloudrun.model.Game">
        UPDATE `game`
        SET `status` = 2,
            `winner_user_id` = #{winnerUserId},
            `deck_remain` = #{deckRemain},
            `ended_at` = NOW()
        WHERE `id` = #{id}
    </update>

    <update id="abortPlaying">
        UPDATE `game` SET `status` = 3, `ended_at` = NOW() WHERE `status` IN (0, 1)
    </update>

</mapper>
