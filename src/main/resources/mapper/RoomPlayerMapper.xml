<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.RoomPlayerMapper">

    <resultMap id="playerMap" type="com.tencent.wxcloudrun.model.RoomPlayer">
        <id property="id" column="id"/>
        <result property="roomId" column="room_id"/>
        <result property="userId" column="user_id"/>
        <result property="seat" column="seat"/>
        <result property="isOwner" column="is_owner"/>
        <result property="isReady" column="is_ready"/>
        <result property="isOnline" column="is_online"/>
        <result property="totalScore" column="total_score"/>
        <result property="joinAt" column="join_at"/>
        <result property="leaveAt" column="leave_at"/>
    </resultMap>

    <sql id="columns">
        `id`, `room_id`, `user_id`, `seat`, `is_owner`, `is_ready`, `is_online`, `total_score`, `join_at`, `leave_at`
    </sql>

    <select id="selectByRoomId" resultMap="playerMap">
        SELECT <include refid="columns"/> FROM `room_player`
        WHERE `room_id` = #{roomId}
        ORDER BY `seat` ASC
    </select>

    <select id="selectByUserId" resultMap="playerMap">
        SELECT <include refid="columns"/> FROM `room_player`
        WHERE `user_id` = #{userId}
        ORDER BY `id` DESC
        LIMIT 1
    </select>

    <select id="selectByRoomAndUser" resultMap="playerMap">
        SELECT <include refid="columns"/> FROM `room_player`
        WHERE `room_id` = #{roomId} AND `user_id` = #{userId}
        LIMIT 1
    </select>

    <select id="countByRoomId" resultType="int">
        SELECT COUNT(*) FROM `room_player` WHERE `room_id` = #{roomId}
    </select>

    <select id="maxSeat" resultType="java.lang.Integer">
        SELECT IFNULL(MAX(`seat`), -1) FROM `room_player` WHERE `room_id` = #{roomId}
    </select>

    <insert id="insert" parameterType="com.tencent.wxcloudrun.model.RoomPlayer"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `room_player`(`room_id`, `user_id`, `seat`, `is_owner`, `is_ready`, `is_online`, `total_score`)
        VALUES(#{roomId}, #{userId}, #{seat}, #{isOwner}, #{isReady}, #{isOnline}, #{totalScore})
    </insert>

    <delete id="deleteByRoomAndUser">
        DELETE FROM `room_player` WHERE `room_id` = #{roomId} AND `user_id` = #{userId}
    </delete>

    <delete id="deleteByRoomId">
        DELETE FROM `room_player` WHERE `room_id` = #{roomId}
    </delete>

    <update id="updateReady">
        UPDATE `room_player` SET `is_ready` = #{ready}
        WHERE `room_id` = #{roomId} AND `user_id` = #{userId}
    </update>

    <update id="setOwner">
        UPDATE `room_player` SET `is_owner` = #{isOwner}
        WHERE `room_id` = #{roomId} AND `user_id` = #{userId}
    </update>

    <update id="resetReady">
        UPDATE `room_player` SET `is_ready` = 0 WHERE `room_id` = #{roomId}
    </update>

</mapper>
